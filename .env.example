# Copy to .env and fill in with values from your secret manager. Never commit .env.
# docker-compose reads this file automatically.

# MySQL superuser password (used only to bootstrap the database container)
MYSQL_ROOT_PASSWORD=

# Least-privilege application account, granted only on the app schema
MYSQL_USER=bankapp
SPRING_DATASOURCE_PASSWORD=

# Image coordinates used by docker-compose
DUSER=
IMAGE=
