# Copy this file to `.env` and fill in real values for your local environment.
# `.env` is git-ignored so it never reaches the repo.

# Docker image build/publish target used by docker-compose.yml `mainapp.image`.
DUSER=your-dockerhub-username
IMAGE=springboot-application

# MySQL credentials shared between the `mysql` and `mainapp` services.
# Use a strong password locally and a secret manager in any real environment.
MYSQL_ROOT_PASSWORD=replace-me
SPRING_DATASOURCE_PASSWORD=replace-me
