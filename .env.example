# Database credentials for the Spring Boot BankApp.
# Copy this file to `.env` (or export these variables in your environment /
# CI secret store) and fill in real values. NEVER commit real secrets.
#
# Spring Boot binds these environment variables to the corresponding
# spring.datasource.* properties via relaxed binding.

# JDBC URL. Optional locally (falls back to the localhost dev default).
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/bankappdb?useSSL=false&serverTimezone=UTC

# Database username. Optional locally (falls back to "root").
SPRING_DATASOURCE_USERNAME=root

# Database password. REQUIRED - there is no default; the app will not start
# without it. Provide via a secret manager in real environments.
SPRING_DATASOURCE_PASSWORD=change-me
