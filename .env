# Image coordinates for the application service in docker-compose.yml:
#   image: ${DUSER}/${IMAGE}:${TAG}
#
# DUSER  registry namespace your organisation controls, e.g.
#        registry.example.com/bank or your organisation's Docker Hub account.
#        Never point this at a personal account.
# TAG    explicit release tag pushed by CI, e.g. TAG=v1.4.2, or pinned to the
#        exact content with TAG=v1.4.2@sha256:<digest>.
#
# DUSER and TAG have no default on purpose: set them here or in the shell
# environment, otherwise `docker compose` stops with an error.
IMAGE=bankapp
