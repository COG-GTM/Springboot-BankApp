# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  'snyk:lic:maven:com.mysql:mysql-connector-j:GPL-2.0':
    - '*':
        reason: >-
          MySQL Connector/J is GPL-2.0 WITH the Universal FOSS Exception 1.0,
          which permits use/distribution alongside other OSS. The connector was
          already a dependency before this PR; the security bump (8.0.33 ->
          9.7.0) changes only the version, not the license posture.
          Non-actionable without swapping the JDBC driver.
        expires: 2027-01-01T00:00:00.000Z
        created: 2026-06-04T21:48:51.877Z
patch: {}
