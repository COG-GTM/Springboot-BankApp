// CI/CD flow for the DevOps branch: Jenkins CI (Jenkinsfile) -> Jenkins CD (GitOps/Jenkinsfile) -> ArgoCD -> EKS.
// Render with docs/diagrams/render.sh (writes images/flow.png).
digraph cicd_flow {
  graph [rankdir=TB, newrank=true, fontname="DejaVu Sans", bgcolor="#f7fbff", pad=0.4, nodesep=0.3, ranksep=0.55,
         label="Springboot-BankApp CI/CD (DevOps branch)", labelloc=t, fontsize=20];
  node  [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", fillcolor=white, color="#5b6b7b", penwidth=1.2, height=0.6];
  edge  [fontname="DejaVu Sans", fontsize=10, color="#44546a", penwidth=1.3];

  dev    [label="Developer", shape=oval, fillcolor="#e8eef6"];
  github [label="GitHub repo\nbranch: DevOps", fillcolor="#24292f", fontcolor=white, color="#24292f"];
  gha    [label="GitHub Actions: e2e.yml\nCypress smoke on PRs and\npushes to DevOps", fillcolor="#f3f0ff", style="rounded,filled,dashed"];

  subgraph cluster_ci {
    label="Jenkins job: BankApp-CI   (Jenkinsfile, shared library vars/)"; style="rounded,filled"; fillcolor="#fff4e5"; color="#d9822b"; fontsize=13;
    ci1 [label="Workspace\ncleanup"];
    ci2 [label="Git: code\ncheckout"];
    ci3 [label="Trivy:\nfilesystem scan", fillcolor="#fde8e8"];
    ci4 [label="OWASP:\ndependency check", fillcolor="#fde8e8"];
    ci5 [label="SonarQube:\ncode analysis", fillcolor="#e6f0ff"];
    ci6 [label="SonarQube:\nquality gate", fillcolor="#e6f0ff"];
    ci7 [label="Docker: build\nbankapp:DOCKER_TAG"];
    ci8 [label="E2E: Cypress smoke\n(docker compose stack)", fillcolor="#eaf7ea"];
    ci9 [label="Docker: push\nto DockerHub"];
    ci1 -> ci2 -> ci3 -> ci4 -> ci5;
    ci5 -> ci6;
    // second row runs right-to-left (tail-left placement + dir=back keeps the snake layout)
    ci7 -> ci6 [dir=back]; ci8 -> ci7 [dir=back]; ci9 -> ci8 [dir=back];
  }

  sonar     [label="SonarQube server", shape=cylinder, fillcolor="#e6f0ff"];
  dockerhub [label="DockerHub\nbankapp image", shape=cylinder, fillcolor="#e3f2fd", color="#1d63ed"];

  subgraph cluster_cd {
    label="Jenkins job: BankApp-CD   (GitOps/Jenkinsfile)"; style="rounded,filled"; fillcolor="#eef7ff"; color="#2b6cb0"; fontsize=13;
    cd1 [label="Workspace cleanup\n+ Git checkout"];
    cd2 [label="Verify\nDOCKER_TAG"];
    cd3 [label="Update image tag in\nkubernetes/bankapp-deployment"];
    cd4 [label="Git commit + push\nto DevOps"];
    cd5 [label="Email notification\n(emailext)"];
    cd1 -> cd2 -> cd3 -> cd4 -> cd5;
  }

  manifests [label="GitHub repo (same), DevOps\nkubernetes/ manifests", fillcolor="#24292f", fontcolor=white, color="#24292f"];

  subgraph cluster_k8s {
    label="AWS EKS cluster: bankapp"; style="rounded,filled"; fillcolor="#fff8e1"; color="#ff9900"; fontsize=13;
    argocd  [label="ArgoCD\n(argocd namespace)", fillcolor="#fde7d9", color="#ef7b4d"];
    bankapp [label="bankapp-namespace\nbankapp-deploy + MySQL", fillcolor="#e8f5e9", color="#2e7d32"];
    bankapp -> argocd [dir=back, label=" sync"];
  }

  dev -> github [label=" git push"];
  github -> ci1 [label=" webhook / poll SCM"];
  github -> gha [style=dashed];
  ci5 -> sonar [dir=both, style=dashed, label=" analysis +\n quality gate"];
  ci9 -> dockerhub [label=" push :DOCKER_TAG"];
  ci9 -> cd1 [label=" on success: build job BankApp-CD\n (DOCKER_TAG)", color="#2b6cb0", fontcolor="#2b6cb0", penwidth=1.8];
  cd4 -> manifests [label=" commit new tag", color="#2b6cb0", fontcolor="#2b6cb0"];
  argocd -> manifests [dir=back, label=" watches", style=dashed, color="#ef7b4d", fontcolor="#ef7b4d"];
  dockerhub -> bankapp [label=" image pull", style=dashed];

  { rank=same; dev; github; gha; }
  { rank=same; ci1; ci2; ci3; ci4; ci5; }
  { rank=same; ci6; ci7; ci8; ci9; }
  { rank=same; sonar; dockerhub; }
  { rank=same; cd1; cd2; cd3; cd4; cd5; }
  { rank=same; manifests; argocd; bankapp; }
}
