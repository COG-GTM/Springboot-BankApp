// Runtime deployment on AWS EKS: kubernetes/ manifests synced by ArgoCD, monitoring via kube-prometheus-stack (Helm).
// Render with docs/diagrams/render.sh (writes images/eks-deployment.png).
digraph eks_deployment {
  graph [rankdir=TB, newrank=true, compound=true, fontname="DejaVu Sans", bgcolor="#f7fbff", pad=0.4, nodesep=0.35, ranksep=0.45,
         label="Springboot-BankApp deployment on AWS EKS (DevOps branch)", labelloc=t, fontsize=26];
  node  [fontname="DejaVu Sans", fontsize=16, shape=box, style="rounded,filled", fillcolor=white, color="#5b6b7b", penwidth=1.2];
  edge  [fontname="DejaVu Sans", fontsize=14, color="#44546a", penwidth=1.3];

  user  [label="Bank customer\n(browser)", shape=oval, fillcolor="#e8eef6"];
  admin [label="DevOps engineer", shape=oval, fillcolor="#e8eef6"];

  github    [label="GitHub repo\nDevOps branch\nkubernetes/ manifests", fillcolor="#24292f", fontcolor=white, color="#24292f"];
  dockerhub [label="DockerHub\nbankapp image", shape=cylinder, fillcolor="#e3f2fd", color="#1d63ed"];
  letsencrypt [label="Let's Encrypt\n(ACME)", fillcolor="#f1f8e9"];

  subgraph cluster_aws {
    label="AWS  us-west-1"; style="rounded,filled"; fillcolor="#fffaf2"; color="#ff9900"; fontsize=20;

    subgraph cluster_master {
      label="Master EC2 (t2.medium)"; style="rounded,filled"; fillcolor="#fff4e5"; color="#d9822b"; fontsize=18;
      jenkins [label="Jenkins :8081\nBankApp-CI / BankApp-CD", fillcolor=white];
      sonar   [label="SonarQube :9000\n(Docker container)", fillcolor="#e6f0ff"];
      tools   [label="Docker, Trivy, OWASP DC\nkubectl, eksctl, argocd CLI, helm", fillcolor=white];
    }

    subgraph cluster_eks {
      label="EKS cluster: bankapp   (eksctl, nodegroup 2 x t2.medium)"; style="rounded,filled"; fillcolor="#fff8e1"; color="#ff9900"; fontsize=19;

      subgraph cluster_ingress_ns {
        label="ingress-nginx / cert-manager"; style="rounded,filled"; fillcolor="#f4f4f4"; color="#9e9e9e"; fontsize=17;
        lb      [label="ingress-nginx controller\n(Service type LoadBalancer)", fillcolor="#e8f5e9"];
        certmgr [label="cert-manager\nClusterIssuer letsencrypt-prod", fillcolor="#f1f8e9"];
      }

      subgraph cluster_argocd {
        label="namespace: argocd"; style="rounded,filled"; fillcolor="#fdf0e8"; color="#ef7b4d"; fontsize=17;
        argocd [label="ArgoCD server (NodePort)\nApplication: bankapp", fillcolor="#fde7d9", color="#ef7b4d"];
      }

      subgraph cluster_app {
        label="namespace: bankapp-namespace"; style="rounded,filled"; fillcolor="#eef8ee"; color="#2e7d32"; fontsize=17;
        ingress [label="Ingress bankapp-ingress\nTLS: bankapp-tls-secret"];
        svc     [label="Service bankapp-service\nClusterIP :8080"];
        deploy  [label="Deployment bankapp-deploy\nSpring Boot pods :8080\n(2 replicas)", fillcolor="#c8e6c9", color="#2e7d32"];
        hpa     [label="HPA bankapp-hpa\n1-5 pods @ 40% CPU", fillcolor=white];
        config  [label="ConfigMap bankapp-config\nSecret mysql-secret", shape=note, fillcolor="#fffde7"];
        mysqlsvc [label="Service mysql-svc\n:3306"];
        mysql   [label="Deployment mysql\nmysql:8.0 (1 replica)", fillcolor="#e3f2fd", color="#1565c0"];
        pvc     [label="PVC mysql-pvc -> PV\n10Gi", shape=cylinder, fillcolor="#e3f2fd", color="#1565c0"];
      }

      subgraph cluster_mon {
        label="namespace: prometheus  (Helm: kube-prometheus-stack)"; style="rounded,filled"; fillcolor="#f3eefb"; color="#7e57c2"; fontsize=17;
        prom    [label="Prometheus\n(NodePort)", fillcolor="#fbe9e7", color="#e65100"];
        grafana [label="Grafana\n(NodePort)", fillcolor="#fff3e0", color="#f57c00"];
      }
    }
  }

  user -> lb [label=" HTTPS\n megaproject.trainwithshubham.com"];
  lb -> ingress [label=" route /"];
  ingress -> svc;
  svc -> deploy;
  hpa -> deploy [style=dashed, label=" scales"];
  config -> deploy [style=dashed, label=" env"];
  deploy -> mysqlsvc [label=" JDBC"];
  mysqlsvc -> mysql;
  mysql -> pvc;
  certmgr -> ingress [style=dashed, label=" issues cert"];
  letsencrypt -> certmgr [style=dashed, dir=both, label=" ACME HTTP-01"];

  github -> argocd [style=dashed, color="#ef7b4d", fontcolor="#ef7b4d", label=" watches kubernetes/"];
  argocd -> ingress [color="#ef7b4d", fontcolor="#ef7b4d", label=" sync / apply", lhead=cluster_app];
  dockerhub -> deploy [style=dashed, label=" image pull"];

  jenkins -> sonar [style=dashed, label=" scan"];
  dockerhub -> jenkins [dir=back, label=" push image"];
  github -> jenkins [dir=back, label=" commit new\n image tag"];

  prom -> deploy [constraint=false, style=dashed, color="#7e57c2", fontcolor="#7e57c2", label=" scrape cluster,\n nodes, workloads"];
  grafana -> prom [label=" query", color="#7e57c2", fontcolor="#7e57c2"];

  admin -> tools [label=" SSH"];
  admin -> argocd [style=dotted, label=" UI"];
  admin -> grafana [style=dotted, label=" dashboards"];

  { rank=same; dockerhub; github; admin; user; letsencrypt; }
  // ordering hints that keep the layout compact
  sonar -> argocd [style=invis]; tools -> lb [style=invis];
}
